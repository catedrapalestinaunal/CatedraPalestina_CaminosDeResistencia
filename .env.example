# ─── Site ────────────────────────────────────────────
VITE_SITE_URL=https://catedrapalestinacaminosderesistencia.com

# ─── Supabase ────────────────────────────────────────
# Project URL: https://asdfdfhbsgdffgfds.supabase.co
# Encontrar en: Project Settings → API → Project URL
# Nota: también agregar como GitHub Actions secret con el mismo nombre
VITE_SUPABASE_URL=https://asdfdfhbsgdffgfds.supabase.co

# anon public key (comienza con eyJ...)
# Encontrar en: Project Settings → API → anon public
# Nota: también agregar como GitHub Actions secret con el mismo nombre
VITE_SUPABASE_ANON_KEY=eyJxxx...

# service_role key (comienza con eyJ...) — NUNCA exponer al frontend
# Encontrar en: Project Settings → API → service_role secret
SUPABASE_SERVICE_KEY=eyJxxx...

# ─── Cloudinary ──────────────────────────────────────
# Obtener en: cloudinary.com → Dashboard
CLOUDINARY_CLOUD_NAME=tu-cloud-name
CLOUDINARY_API_KEY=123456789
CLOUDINARY_API_SECRET=abc123def456

# Upload preset (debe coincidir con el preset configurado en Cloudinary)
CLOUDINARY_UPLOAD_PRESET=catedra_palestina